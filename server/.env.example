# Railway injects DATABASE_URL automatically when you attach a Postgres plugin.
# For local dev, point this at your own Postgres instance.
DATABASE_URL=postgres://user:pass@localhost:5432/sessionzero

# Set to "false" only for a local Postgres without SSL. On Railway, leave unset.
# DATABASE_SSL=false

# Browser origins allowed to call this API (comma-separated). Defaults already
# cover the live site, the github.io mirror, and localhost:8080.
# ALLOWED_ORIGINS=https://sessionzero.games,http://localhost:8080

# PORT is provided by Railway; only needed for local runs.
# PORT=3000
